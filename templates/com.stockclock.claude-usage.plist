<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Sends your Claude plan usage to the clock every 5 minutes.
     Replace HOME_DIR (e.g. /Users/you) and CLOCK_IP, save as
     ~/Library/LaunchAgents/com.stockclock.claude-usage.plist, then:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.stockclock.claude-usage.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.stockclock.claude-usage</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>HOME_DIR/Library/Application Support/StockClock/claude_usage_push.py</string>
    <string>CLOCK_IP</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>HOME_DIR/Library/Application Support/StockClock/push.log</string>
  <key>StandardErrorPath</key><string>HOME_DIR/Library/Application Support/StockClock/push.log</string>
</dict>
</plist>
