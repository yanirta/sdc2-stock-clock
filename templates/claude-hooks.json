{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "STOCK_CLOCK_IP=CLOCK_IP /usr/bin/python3 \"$HOME/Library/Application Support/StockClock/clock_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "STOCK_CLOCK_IP=CLOCK_IP /usr/bin/python3 \"$HOME/Library/Application Support/StockClock/clock_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "STOCK_CLOCK_IP=CLOCK_IP /usr/bin/python3 \"$HOME/Library/Application Support/StockClock/clock_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "STOCK_CLOCK_IP=CLOCK_IP /usr/bin/python3 \"$HOME/Library/Application Support/StockClock/clock_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test -n \"$(ls -A \"$HOME/Library/Application Support/StockClock/active\" 2>/dev/null)\" && STOCK_CLOCK_IP=CLOCK_IP /usr/bin/python3 \"$HOME/Library/Application Support/StockClock/clock_hook.py\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
